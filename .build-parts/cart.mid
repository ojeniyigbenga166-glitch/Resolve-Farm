
  <main>

    <!-- PAGE BAND -->
    <section class="shop-page-band">
      <div class="shop-page-band-container">
        <nav class="shop-breadcrumb-inline" aria-label="Breadcrumb">
          <ol>
            <li><a href="../index.html">Home</a></li>
            <li><a href="shop.html">Farm Shop</a></li>
            <li aria-current="page">Cart</li>
          </ol>
        </nav>
        <h1>Your Cart</h1>
        <p data-cart-count aria-live="polite">0 items</p>
      </div>
    </section>

    <!-- EMPTY CART -->
    <section class="shop-notice" data-cart-empty hidden>
      <div class="shop-notice-inner">
        <span class="shop-notice-icon" aria-hidden="true">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        </span>
        <h2>Your cart is empty</h2>
        <p>Nothing picked yet. Have a look at what is coming out of the fields this week.</p>
        <a href="shop.html" class="btn btn-primary">Browse the Farm Shop
          <span class="btn-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
        </a>
      </div>
    </section>

    <!-- CART LAYOUT -->
    <section class="cart-section" data-cart-layout hidden>
      <div class="cart-container">

        <!-- Line items -->
        <div class="cart-main">
          <div class="cart-delivery-meter" data-cart-delivery-meter hidden>
            <p data-cart-delivery-text></p>
            <div class="cart-delivery-track">
              <span class="cart-delivery-bar" data-cart-delivery-bar></span>
            </div>
          </div>

          <ul class="cart-lines" data-cart-lines>
            <!-- Cart lines rendered by cart-page.js -->
          </ul>

          <div class="cart-main-actions">
            <a href="shop.html" class="cart-continue">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
              Continue shopping
            </a>
            <button type="button" class="cart-clear" data-cart-clear>Clear cart</button>
          </div>
        </div>

        <!-- Summary -->
        <aside class="cart-summary" aria-label="Order summary">
          <h2>Order Summary</h2>

          <dl class="cart-summary-rows">
            <div>
              <dt>Subtotal</dt>
              <dd data-cart-subtotal>$0.00</dd>
            </div>
            <div>
              <dt>Delivery</dt>
              <dd data-cart-delivery>Free</dd>
            </div>
          </dl>

          <div class="cart-summary-total">
            <span>Total</span>
            <strong data-cart-total>$0.00</strong>
          </div>

          <a href="checkout.html" class="btn btn-primary cart-checkout-btn">
            Proceed to Checkout
            <span class="btn-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
          </a>

          <ul class="cart-summary-notes">
            <li>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              Harvested after your order is placed
            </li>
            <li>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              Free delivery on orders over $75
            </li>
            <li>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              Questions? Call +1 (800) 234-5678
            </li>
          </ul>
        </aside>

      </div>
    </section>

  </main>

