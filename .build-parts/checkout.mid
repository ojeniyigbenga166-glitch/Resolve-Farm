
  <main>

    <!-- PAGE BAND -->
    <section class="shop-page-band">
      <div class="shop-page-band-container">
        <nav class="shop-breadcrumb-inline" aria-label="Breadcrumb">
          <ol>
            <li><a href="../index.html">Home</a></li>
            <li><a href="shop.html">Farm Shop</a></li>
            <li><a href="cart.html">Cart</a></li>
            <li aria-current="page">Checkout</li>
          </ol>
        </nav>
        <h1>Checkout</h1>
        <p>Tell us where the harvest is going and we will pick it fresh for you.</p>
      </div>
    </section>

    <!-- EMPTY CART -->
    <section class="shop-notice" data-checkout-empty hidden>
      <div class="shop-notice-inner">
        <span class="shop-notice-icon" aria-hidden="true">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        </span>
        <h2>There is nothing to check out</h2>
        <p>Add a few things from the Farm Shop and we will get your order moving.</p>
        <a href="shop.html" class="btn btn-primary">Browse the Farm Shop
          <span class="btn-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
        </a>
      </div>
    </section>

    <!-- CHECKOUT LAYOUT -->
    <section class="checkout-section" data-checkout-layout hidden>
      <div class="checkout-container">

        <!-- Form -->
        <form class="checkout-form" data-checkout-form novalidate>

          <p class="checkout-form-error" data-checkout-error role="alert" hidden></p>

          <fieldset class="checkout-fieldset">
            <legend>
              <span class="checkout-step">1</span>
              Contact details
            </legend>

            <div class="checkout-field">
              <label for="fullName">Full name <span aria-hidden="true">*</span></label>
              <input type="text" id="fullName" name="fullName" class="form-input-ref" autocomplete="name" placeholder="Ada Okonkwo" required>
              <p class="checkout-error" aria-live="polite"></p>
            </div>

            <div class="checkout-field-row">
              <div class="checkout-field">
                <label for="email">Email <span aria-hidden="true">*</span></label>
                <input type="email" id="email" name="email" class="form-input-ref" autocomplete="email" placeholder="you@example.com" required>
                <p class="checkout-error" aria-live="polite"></p>
              </div>

              <div class="checkout-field">
                <label for="phone">Phone <span aria-hidden="true">*</span></label>
                <input type="tel" id="phone" name="phone" class="form-input-ref" autocomplete="tel" placeholder="(519) 555 0123" required>
                <p class="checkout-error" aria-live="polite"></p>
              </div>
            </div>
          </fieldset>

          <fieldset class="checkout-fieldset">
            <legend>
              <span class="checkout-step">2</span>
              Delivery address
            </legend>

            <div class="checkout-field">
              <label for="address">Street address <span aria-hidden="true">*</span></label>
              <input type="text" id="address" name="address" class="form-input-ref" autocomplete="street-address" placeholder="1228 Lakeshore Rd 105" required>
              <p class="checkout-error" aria-live="polite"></p>
            </div>

            <div class="checkout-field-row">
              <div class="checkout-field">
                <label for="city">City <span aria-hidden="true">*</span></label>
                <input type="text" id="city" name="city" class="form-input-ref" autocomplete="address-level2" placeholder="Maidstone" required>
                <p class="checkout-error" aria-live="polite"></p>
              </div>

              <div class="checkout-field">
                <label for="province">Province <span aria-hidden="true">*</span></label>
                <select id="province" name="province" class="form-input-ref" autocomplete="address-level1" required>
                  <option value="">Select province</option>
                  <option value="ON" selected>Ontario</option>
                  <option value="AB">Alberta</option>
                  <option value="BC">British Columbia</option>
                  <option value="MB">Manitoba</option>
                  <option value="NB">New Brunswick</option>
                  <option value="NL">Newfoundland and Labrador</option>
                  <option value="NS">Nova Scotia</option>
                  <option value="NT">Northwest Territories</option>
                  <option value="NU">Nunavut</option>
                  <option value="PE">Prince Edward Island</option>
                  <option value="QC">Quebec</option>
                  <option value="SK">Saskatchewan</option>
                  <option value="YT">Yukon</option>
                </select>
                <p class="checkout-error" aria-live="polite"></p>
              </div>

              <div class="checkout-field">
                <label for="postalCode">Postal code <span aria-hidden="true">*</span></label>
                <input type="text" id="postalCode" name="postalCode" class="form-input-ref" autocomplete="postal-code" placeholder="N0R 1K0" required>
                <p class="checkout-error" aria-live="polite"></p>
              </div>
            </div>

            <div class="checkout-field">
              <label for="notes">Delivery notes <span class="checkout-optional">(optional)</span></label>
              <textarea id="notes" name="notes" class="form-input-ref checkout-textarea" placeholder="Gate code, best time to drop off, anything else we should know."></textarea>
            </div>
          </fieldset>

          <fieldset class="checkout-fieldset">
            <legend>
              <span class="checkout-step">3</span>
              Payment
            </legend>

            <p class="checkout-payment-note">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
              <span>Online card payment is not live yet. Choose how you would like to settle up and we will confirm by phone or email before delivery. <strong>No card is charged now.</strong></span>
            </p>

            <div class="checkout-payment-options">
              <label class="checkout-payment-option">
                <input type="radio" name="paymentMethod" value="pay-on-delivery" checked>
                <span class="checkout-payment-body">
                  <strong>Pay on delivery</strong>
                  <span>Cash, debit or e-transfer when we hand over the produce.</span>
                </span>
              </label>

              <label class="checkout-payment-option">
                <input type="radio" name="paymentMethod" value="e-transfer">
                <span class="checkout-payment-body">
                  <strong>Interac e-Transfer in advance</strong>
                  <span>We email transfer details as soon as the order is confirmed.</span>
                </span>
              </label>

              <label class="checkout-payment-option">
                <input type="radio" name="paymentMethod" value="invoice">
                <span class="checkout-payment-body">
                  <strong>Invoice me (wholesale)</strong>
                  <span>For restaurants and retailers with an account.</span>
                </span>
              </label>
            </div>
          </fieldset>

          <button type="submit" class="btn btn-primary checkout-submit" data-checkout-submit>
            <span class="checkout-submit-label">Place Order</span>
            <span class="checkout-submit-total" data-checkout-submit-total>$0.00</span>
          </button>

          <p class="checkout-submit-reassure">
            You will see a confirmation with your order number on the next screen.
          </p>

        </form>

        <!-- Summary -->
        <aside class="checkout-summary" aria-label="Order summary">
          <h2>Your Order</h2>

          <ul class="checkout-summary-lines" data-checkout-lines>
            <!-- Summary lines rendered by checkout.js -->
          </ul>

          <dl class="cart-summary-rows">
            <div>
              <dt>Subtotal</dt>
              <dd data-checkout-subtotal>$0.00</dd>
            </div>
            <div>
              <dt>Delivery</dt>
              <dd data-checkout-delivery>Free</dd>
            </div>
          </dl>

          <div class="cart-summary-total">
            <span>Total</span>
            <strong data-checkout-total>$0.00</strong>
          </div>

          <p class="checkout-delivery-note" data-checkout-delivery-note></p>

          <a href="cart.html" class="cart-continue checkout-back">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
            Back to cart
          </a>
        </aside>

      </div>
    </section>

  </main>

